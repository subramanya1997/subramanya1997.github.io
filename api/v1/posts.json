---
layout: none
permalink: /api/v1/posts.json
sitemap: false
---
{
  "api_version": "v1",
  "kind": "post_list",
  "generated_from": "{{ site.url }}/openapi.json",
  "count": {{ site.posts | size }},
  "posts": [
    {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | prepend: site.baseurl | prepend: site.url | jsonify }},
      "markdown_url": {{ post.url | append: "index.md" | prepend: site.baseurl | prepend: site.url | jsonify }},
      "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
      "excerpt": {{ post.excerpt | strip_html | strip_newlines | strip | jsonify }},
      "tags": {{ post.tags | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
