---
layout: none
permalink: /api/v1/site.json
sitemap: false
---
{
  "api_version": "v1",
  "kind": "site_info",
  "generated_from": "{{ site.url }}/openapi.json",
  "name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "url": {{ site.url | jsonify }},
  "author": {
    "name": {{ site.title | jsonify }},
    "email": {{ site.email | jsonify }},
    "github": "https://github.com/{{ site.data.about.github_username }}",
    "linkedin": "https://www.linkedin.com/in/{{ site.data.about.linkedin_username }}"
  },
  "counts": {
    "posts": {{ site.posts | size }},
    "books": {{ site.books | size }},
    "loops": {{ site.loops | size }}
  },
  "endpoints": {
    "openapi": "{{ site.url }}/openapi.json",
    "posts": "{{ site.url }}/api/v1/posts.json",
    "books": "{{ site.url }}/api/v1/books.json",
    "tags": "{{ site.url }}/api/v1/tags.json",
    "search_index": "{{ site.url }}/search.json",
    "llms_txt": "{{ site.url }}/llms.txt",
    "sitemap": "{{ site.url }}/sitemap.xml",
    "feed": "{{ site.url }}/feed.xml",
    "api_catalog": "{{ site.url }}/.well-known/api-catalog"
  },
  "policies": {
    "deprecation_policy": "{{ site.url }}/docs/api-deprecation-policy/",
    "privacy": "{{ site.url }}/privacy/",
    "contact": "{{ site.url }}/contact/"
  }
}
